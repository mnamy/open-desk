# Injected by the Vercel Neon integration. Leave all of these unset to use local PGlite.
# Pooled connection used by the running app.
DATABASE_URL=

# Direct connection used for migrations.
DATABASE_URL_UNPOOLED=

# Legacy names also set by the Vercel Neon integration. Used only when the names above are absent.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
